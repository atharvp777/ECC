# 1. Install (or refresh) all node dependencies
npm install

# 2. Start the FastAPI backend (in a separate terminal)
uvicorn backend.app.main:app --port 8000

# 3. Launch the Tauri development environment – this will:
#    • Free port 1420 if needed
#    • Start Vite
#    • Start Tauri with the frontend pointing at the backend on localhost:8000
npm run tauri -- dev
