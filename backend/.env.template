# Copy this file to .env and fill in your values

# AI provider — "gemini" (gemini-3.5-flash-lite) is the default primary provider.
# Set AI_PROVIDER=groq to fall back to Groq (llama-3.3-70b).
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite

# Google Gemini API key — get at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API (free) — get at console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Google Calendar OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
